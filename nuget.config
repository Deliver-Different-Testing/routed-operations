<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources.

     nuget.org: public packages.
     gitlab-alertlabel: DeliverDifferent.AlertLabel.Data (GitLab project 809).
       Used by the Route Viewer label service to generate label PDFs
       directly instead of proxying to the legacy RunViewer's
       /Home/Labels/* endpoints. See
       Core/Application/Services/RouteViewer/RouteViewerLabelService.cs.

     Restore credentials come from env vars GITLAB_NUGET_USERNAME +
     GITLAB_NUGET_TOKEN. Local dev sets these in the developer's shell.
     CI runners need both secrets configured on the pipeline before the
     first restore against gitlab-alertlabel; missing them fails restore
     with an authentication error. Same convention the legacy RunViewer
     repo uses. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="gitlab" value="https://git.customd.com/api/v4/projects/797/packages/nuget/index.json" />
    <add key="gitlab-alertlabel" value="https://git.customd.com/api/v4/projects/809/packages/nuget/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <gitlab>
      <add key="Username" value="%GITLAB_NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%GITLAB_NUGET_TOKEN%" />
    </gitlab>
    <gitlab-alertlabel>
      <add key="Username" value="%GITLAB_NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%GITLAB_NUGET_TOKEN%" />
    </gitlab-alertlabel>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="gitlab">
      <package pattern="DeliverDifferentReporting" />
    </packageSource>
    <packageSource key="gitlab-alertlabel">
      <package pattern="DeliverDifferent.AlertLabel.Data" />
    </packageSource>
  </packageSourceMapping>
</configuration>
