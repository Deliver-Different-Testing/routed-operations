<?xml version="1.0" encoding="utf-8"?>
<!-- Pin the restore feed to nuget.org only. Prevents CI restore from picking up
     a machine-level Telerik/private source that fails to authenticate in the
     clean Docker build image. Matches the DFRNT stack convention. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
