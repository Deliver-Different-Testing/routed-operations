@model RoutedOperations.Controllers.AppUserBootstrap
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    var bootstrapJson = System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    });

    // Cache-busting version stamp - uses the built bundle's mtime so a
    // rebuild (via `npm run build:watch` or `npm run build`) automatically
    // invalidates the browser cache on next page load. Falls back to app
    // start time if the dist file isn't there yet (first build).
    string BundleVersion(string relativePath)
    {
        try
        {
            var full = System.IO.Path.Combine(Env.WebRootPath, relativePath.TrimStart('/'));
            if (System.IO.File.Exists(full))
            {
                return System.IO.File.GetLastWriteTimeUtc(full).Ticks.ToString();
            }
        }
        catch { }
        return DateTime.UtcNow.Ticks.ToString();
    }
    var jsVer = BundleVersion("dist/app.js");
    var cssVer = BundleVersion("dist/app.css");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Routed Operations</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/dist/app.css?v=@cssVer" />
    <!-- HERE Maps JS v3 - still loaded because the Fix GPS modal uses HERE
         geocoding. The main cockpit map surface uses Google Maps instead
         (see the script tag below) for parity with the legacy RunBuilder. -->
    <link rel="stylesheet" type="text/css" href="https://js.api.here.com/v3/3.1/mapsjs-ui.css" />
    <script src="https://js.api.here.com/v3/3.1/mapsjs-core.js" type="text/javascript" charset="utf-8"></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-service.js" type="text/javascript" charset="utf-8"></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-ui.js" type="text/javascript" charset="utf-8"></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-mapevents.js" type="text/javascript" charset="utf-8"></script>
    @if (!string.IsNullOrEmpty(Model?.GoogleMapsKey))
    {
        <!-- Google Maps SDK for the cockpit map surface. Matches the legacy
             RunBuilder which loaded google.maps + Directions + Places. The
             async attribute lets the SPA mount first; the map component
             re-checks window.google.maps before rendering. -->
        <script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapsKey&libraries=places,geometry" async defer></script>
    }
</head>
<body>
    <div id="routed-operations-root"></div>

    <script>
        window.__APP_USER__ = @Html.Raw(bootstrapJson);
    </script>
    <script type="module" src="/dist/app.js?v=@jsVer"></script>
</body>
</html>
