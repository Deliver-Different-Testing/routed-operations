<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Suppresses any BeforeTargets=Build tasks on the referenced web project
         (npm run build etc.) when the test project builds. Matches Configurator's
         tests/DfrntDriveConfigurator.Tests.csproj pattern. -->
    <CI>true</CI>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit.v3 with Microsoft Testing Platform (OutputType=Exe above wires MTP
         so the runner is `dotnet run` in Release configuration, not `dotnet test`).
         Matches Configurator + DespatchWeb's shape. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />

    <!-- EF Core testing providers. InMemory is the default for service-layer
         tests; Sqlite is opt-in per-test for scenarios that need SQL Server-shaped
         behaviour (relational functions, tracker semantics). Both pinned to
         match the main project's EF Core 10.0.3. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.3" />

    <!-- WebApplicationFactory for controller-level + bootstrap integration
         tests (Phase 3 covers Program.cs via this). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />

    <!-- Coverage collector. PrivateAssets=all so consumers of this test project
         (there are none, but standard-form) do not transitively pull coverlet. -->
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Test files skip per-file `using Xunit;` + `using NSubstitute;` boilerplate. -->
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests need HttpContext / ClaimsPrincipal / WebApplicationFactory; these
         do not flow transitively from the app project's Sdk.Web reference. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RoutedOperations.csproj" />
  </ItemGroup>

</Project>
